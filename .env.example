# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# Two URLs, both from the Neon console. Cloud Run is a long-lived Node process
# with real TCP, not an edge function, so we use plain `pg` against Neon's
# pooler rather than the serverless HTTP/WebSocket driver.
#
# `sslmode=verify-full`, not `require`: today `pg` treats the two as the same
# thing, but pg 9 adopts libpq's semantics, where `require` encrypts without
# checking the certificate. That change arrives silently — same connection,
# same logs, no error — so the stricter word goes in now.
#
# App runtime — the POOLED string (host contains `-pooler`).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full

# Migrations only — the DIRECT/unpooled string (no `-pooler`). Neon documents
# the pooler as unsuitable for schema migrations, which need session-level
# state. drizzle-kit reads this one; the app never does.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=verify-full

# ---------------------------------------------------------------------------
# Auth — BetterAuth
# ---------------------------------------------------------------------------
# Signing key for sessions. Generate with: openssl rand -base64 32
# Changing it invalidates every existing session.
BETTER_AUTH_SECRET=

# The app's own origin, no trailing slash. Must match where the app is actually
# served or sign-in cookies and redirects break.
#   local: http://localhost:3012
#   prod:  https://<your-domain>
BETTER_AUTH_URL=http://localhost:3012

# ---------------------------------------------------------------------------
# Seed — the admin
# ---------------------------------------------------------------------------
# Read by `pnpm seed`, which grants this Coach the admin role, creating them
# first if they do not exist. Invite-only means there is no sign-up route, so
# this is how the first Coach comes to exist; every other one is added on
# `/admin`.
#
# Admin is a role on the account, and `pnpm seed` is what grants it, so the
# bootstrap is: fill these in, `pnpm seed`, sign in. Re-running it changes
# nothing, and pointing it at an existing Coach makes that Coach an admin.
#
# Changing the email later does NOT move admin-ness — the role stays on the
# old row. Run `pnpm seed` again to grant it to the new one.
#
# The password is only this Coach's first one. `/admin` sets passwords after
# that, and a change here does not reach an account that already exists.
SEED_ADMIN_USER=coach@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=First Coach

# ---------------------------------------------------------------------------
# Engine — Stockfish
# ---------------------------------------------------------------------------
# Absolute path to the Stockfish binary. In the container this is set by the
# Dockerfile; set it locally to whatever your package manager installed.
#   macOS (brew install stockfish): /opt/homebrew/bin/stockfish
#   Debian/Ubuntu (apt install stockfish): /usr/games/stockfish
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Milliseconds the engine may think per move. Puzzles are a few moves deep, so
# this stays small — it is the defender playing sound moves, not analysis.
ENGINE_MOVETIME_MS=200

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# The floor below which `src/lib/log.ts` writes nothing: debug, info, warn or
# error. Unset means debug locally and info in production — set this only to
# override that, e.g. warn to quiet a noisy retry while chasing something else.
LOG_LEVEL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Cloud Run injects PORT and ignores anything set here. Local only, where it
# is the dev server's port too, so it must agree with BETTER_AUTH_URL above.
PORT=3012

# ---------------------------------------------------------------------------
# Deferred — not needed for the MVP (see docs/BACKLOG.md)
# ---------------------------------------------------------------------------
# Password reset is cut from the MVP: Resend's sandbox sender only delivers to
# the account owner, so real reset mail needs a verified domain. Until then the
# admin sets Coach passwords by hand. Uncomment when a domain is verified.
# RESEND_API_KEY=
# RESEND_FROM=Learn Chess <noreply@your-domain>

# ---------------------------------------------------------------------------
# End-to-end tests
# ---------------------------------------------------------------------------
# The local Postgres that `pnpm e2e` owns outright: it drops and recreates
# databases on this server, so never point it at anything you care about.
# `docker compose up -d` provides one on 5433.
#
# The host, port and credentials are used as-is; the database name is swapped
# to reach the maintenance and template databases, so one variable configures
# all three. It must not name "learn-chess" — that is the one the provisioner
# connects through to drop the others.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/learn-chess-e2e
