#!/usr/bin/env bash
# Versioned, unlike .git/hooks. `pnpm prepare` points git here.
set -euo pipefail

# NUL-delimited so a path with a space survives xargs.
staged() {
  git diff --cached --name-only --diff-filter=ACMR -z \
    -- '*.ts' '*.tsx' '*.js' '*.jsx'
}

[ -n "$(staged)" ] || exit 0

# ponytail: re-stages whole files, so a partially staged one (`git add -p`)
# commits its unstaged hunks too. Reach for lint-staged if that ever bites.
staged | xargs -0 pnpm exec prettier --write --ignore-unknown
staged | xargs -0 git add --
